# --- AI providers (at least one recommended; the app runs in demo mode without any) ---
# Anthropic — powers Fable 5, Opus 4.8, Sonnet 5, Haiku 4.5
ANTHROPIC_API_KEY=

# OpenAI — powers the GPT script writer option
OPENAI_API_KEY=
# Override the OpenAI model id if needed (default: gpt-5.5)
OPENAI_MODEL=gpt-5.5

# --- B-roll (optional) ---
# Free key at https://www.pexels.com/api/ — matches real stock clips to each scene
PEXELS_API_KEY=

# --- Performance feedback loop (optional) ---
# With these set, the Insights page pulls your real channel data.
# Without them, bundled sample data is used so the loop still works end to end.
# Instagram Graph API (long-lived token + IG business account id)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# YouTube Data API v3 (API key + channel id)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
